# Copy this file to .env and fill in real values. Never commit .env.

PORT=4000

# CORS: the origin your frontend is served from
CORS_ORIGIN=http://localhost:5173

# Google Maps Platform key — used server-side only (Directions / Distance Matrix / Geocoding).
# Get one at https://console.cloud.google.com/google/maps-apis
# Leave blank to keep RESQFLOW running on simulated routing data.
GOOGLE_MAPS_API_KEY=

# Optional: real traffic / weather providers, if you wire them into services/
TRAFFIC_API_KEY=
WEATHER_API_KEY=

# MongoDB connection string, if you swap the in-memory mock data store for a
# real database (data/mockData.js documents the expected shape).
MONGODB_URI=
